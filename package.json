      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@next/third-parties": "^16.3.5",
    "@react-email/render": "^2.1.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@svgr/webpack": "^8.1.0",
